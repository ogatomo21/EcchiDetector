[Unit]
Description=EcchiDetector Discord Bot
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=ecchidetector
Group=ecchidetector
WorkingDirectory=/opt/EcchiDetector
EnvironmentFile=/etc/ecchidetector.env
ExecStart=/opt/EcchiDetector/EcchiDetector
StateDirectory=ecchidetector
StateDirectoryMode=0750
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
PrivateDevices=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
